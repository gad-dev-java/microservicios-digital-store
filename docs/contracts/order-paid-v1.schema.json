{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-store.local/contracts/order-paid-v1.schema.json",
  "title": "ORDER_PAID v1",
  "description": "Payload JSON de orders.events.v1. Kafka usa orderId como key y envía eventId, traceparent y tracestate como headers cuando corresponda. buyerEmail y buyerSub son datos internos: no publicar este evento fuera del entorno confiable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "orderId",
    "buyerSub",
    "buyerEmail",
    "amount",
    "currency",
    "productIds",
    "items"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ORDER_PAID" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "orderId": { "type": "string", "format": "uuid" },
    "buyerSub": { "type": "string", "minLength": 1 },
    "buyerEmail": { "type": "string", "format": "email" },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "const": "PEN" },
    "productIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uuid" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "sku", "title", "quantity", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "format": "uuid" },
          "sku": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
